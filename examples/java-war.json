{
  "id": "myapp",
  "label": "My App (운영)",
  "repo": "C:/work/repos/my-app",
  "mainBranch": "main",
  "runs": "C:/work/repos/my-app/.local/deploy",
  "connection": {
    "protocol": "ftp",
    "host": "ftp.example.com",
    "port": 21,
    "root": "/webapps/ROOT",
    "passive": true
  },
  "mappings": [
    { "local": "src/main/webapp", "remote": "/" },
    { "local": "build/classes/java/main", "remote": "/WEB-INF/classes" }
  ],
  "java": {
    "source": "src/main/java",
    "output": "build/classes/java/main",
    "major": 52,
    "build": ".\\gradlew.bat classes"
  },
  "manual": [
    { "pattern": "src/main/webapp/WEB-INF/web.xml", "reason": "운영 서버가 별도 파일을 씀 — 필요한 변경만 손으로" },
    { "pattern": "src/main/webapp/META-INF/**", "reason": "운영 서버가 별도 파일을 씀 — 필요한 변경만 손으로" },
    { "pattern": "src/main/resources/**", "reason": "환경별 설정(logback 등) — 손으로" },
    { "pattern": "libs/**", "reason": "jar 교체 — 백업·재기동과 함께 손으로" }
  ]
}
